generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          String    @default("user")
  orgName       String?
  orgType       String?
  orgSize       String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   // 'email', 'password-reset', etc.
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Participant {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  phone            String?
  tags             String[]
  location         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assessmentHistory Assessment[]
  activityLogs     ActivityLog[]
}

model Assessment {
  id            String   @id @default(cuid())
  participantId String
  score         Int
  type          String
  notes         String?
  createdAt     DateTime @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  participantId String
  activity      String
  details       String?
  createdAt     DateTime @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
} 