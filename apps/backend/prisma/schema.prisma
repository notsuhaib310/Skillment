generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  free
  elite
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  password           String
  firstName          String
  lastName           String
  phone              String?       // NEW - Added for subscription
  gender             String?       // NEW - Added for registration
  role               String        @default("user")
  emailVerified      Boolean       @default(false)
  termsAccepted      Boolean       @default(false) // NEW
  newsletterOptIn    Boolean       @default(false) // NEW
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  orgId              String?
  sessions           Session[]
  organization       Organization? @relation(fields: [orgId], references: [id])
  createdAssessments Assessment[]
  candidates         Candidate[]
  teamInvitations    TeamMember[]  @relation("InvitedBy")

  @@index([orgId])
}

model Organization {
  id                 String   @id @default(cuid())
  name               String   @unique // URL-friendly name
  displayName        String?  // NEW - Human readable name
  type               String
  size               String
  plan               PlanType @default(free)
  subscriptionId     String?  // NEW - Razorpay subscription ID
  subscriptionStatus String?  // NEW - active, cancelled, halted, etc.
  logo               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
  teamMembers        TeamMember[]

  @@index([subscriptionId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  token     String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Optional: Add payment tracking
model Payment {
  id               String   @id @default(cuid())
  organizationId   String
  subscriptionId   String
  paymentId        String   @unique
  amount           Int
  currency         String   @default("INR")
  status           String
  razorpayData     Json?
  createdAt        DateTime @default(now())

  @@map("payments")
}

// Keep your existing models
model Participant {
  id                String              @id @default(cuid())
  name              String
  email             String              @unique
  phone             String?
  tags              String[]
  location          String?
  organization      String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  activityLogs      ActivityLog[]
  assessmentScores  ParticipantScore[]
}

model ActivityLog {
  id            String      @id @default(cuid())
  participantId String
  activity      String
  details       String?
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model Assessment {
  id                String              @id @default(cuid())
  title             String
  description       String?
  instructions      String?             // NEW - Enhanced instructions field
  type              String
  status            String              @default("draft")
  duration          Int
  totalMarks        Int
  passingMarks      Int                 @default(60) // NEW - Passing marks threshold
  totalQuestions    Int
  attemptLimit      Int                 @default(1)
  showResults       Boolean             @default(true)
  showCorrectAnswers Boolean            @default(false) // NEW - Control answer visibility
  enableProctoring  Boolean             @default(false)
  randomizeQuestions Boolean            @default(false)
  randomizeOptions   Boolean            @default(false)
  tags              String[]
  notes             String?
  participantScores ParticipantScore[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdById       String
  createdBy         User                @relation(fields: [createdById], references: [id])
  questions         Question[]
  candidates        Candidate[]
  analytics         AssessmentAnalytics?
  allowBackNavigation   Boolean   @default(true)
  timeWarnings         Boolean   @default(true)
  autoSubmit           Boolean   @default(true)
  warningTimes         String?   // e.g. "30,15,5"
  // Proctoring Configuration
  webcamMonitoring     Boolean   @default(false)
  screenRecording      Boolean   @default(false)
  tabSwitchDetection   Boolean   @default(false)
  copyPasteDetection   Boolean   @default(false)
  rightClickDisable    Boolean   @default(false)
  fullscreenMode       Boolean   @default(false)
  idVerification       Boolean   @default(false)
  environmentCheck     Boolean   @default(false)
  suspiciousActivityThreshold Int?
  warningBeforeFlagging Boolean  @default(true)
  videoQuality         String?
  recordingFrequency   String?
  dataRetention        String?
  autoDeleteAfter      String?
}

model Question {
  id            String      @id @default(cuid())
  assessmentId  String
  question      String
  type          String
  options       Json?       // Legacy field for backward compatibility
  correctAnswer Json?       // Legacy field for backward compatibility
  marks         Int
  order         Int
  hints         String[]
  explanation   String?
  difficulty    String?
  tags          String[]
  // Enhanced question data
  mcqData       Json?       // NEW - MCQ specific data (options, multipleCorrect, etc.)
  codingData    Json?       // NEW - Coding specific data (languages, starter code, test cases, etc.)
  aiMetadata    Json?       // NEW - AI generation metadata
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  @@index([assessmentId])
}

model Candidate {
  id            String        @id @default(cuid())
  assessmentId  String
  userId        String?
  name          String
  email         String
  status        String        @default("invited")
  score         Int?         
  timeSpent     Int?
  startedAt     DateTime?
  submittedAt   DateTime?
  answers       Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  allottedBy    String?
  allottedAt    DateTime?
  password      String?      // <-- Add this line for demo/testing only
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([assessmentId])
  @@index([userId])
}

model ParticipantScore {
  id             String      @id @default(cuid())
  participant   Participant @relation(fields: [participantId], references: [id])
  participantId String
  assessment    Assessment  @relation(fields: [assessmentId], references: [id])
  assessmentId  String
  score         Int
  status        String      @default("not_started")
  startedAt     DateTime?
  completedAt   DateTime?
  answers       Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([participantId, assessmentId])
}

model AssessmentAnalytics {
  id                   String     @id @default(cuid())
  assessmentId         String     @unique
  totalCandidates      Int        @default(0)
  completedCandidates  Int        @default(0)
  averageScore         Float?     @default(0)
  completionRate       Float?     @default(0)
  scoreDistribution   Json?
  questionStatistics   Json?
  updatedAt            DateTime   @updatedAt
  assessment           Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Team Member Management
model TeamMember {
  id                String   @id @default(cuid())
  email             String
  firstName         String?
  lastName          String?
  role              String   @default("member") // admin, member, viewer
  permissions       Json     @default("{}") // Store permissions as JSON
  status            String   @default("pending") // pending, active, inactive
  invitedBy         String
  invitedByUser     User     @relation("InvitedBy", fields: [invitedBy], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedAt         DateTime @default(now())
  acceptedAt        DateTime?
  lastActiveAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([email])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id           String   @id @default(cuid())
  to           String
  candidateId  String?
  assessmentId String?
  templateId   String?
  subject      String
  body         String
  status       String   // draft, sent, delivered, opened, clicked, failed
  error        String?
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdById  String
  createdAt    DateTime @default(now())
}

model Credential {
  id           String   @id @default(cuid())
  candidateId  String   @unique
  email        String
  passwordHash String
  createdAt    DateTime @default(now())
  lastSentAt   DateTime?
}