generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  firstName     String
  lastName      String
  role          String        @default("user")
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orgId         String?
  sessions           Session[]
  organization       Organization? @relation(fields: [orgId], references: [id])
  createdAssessments Assessment[]
  candidates         Candidate[]

  @@index([orgId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String
  size      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logo      String?
  users     User[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String
  createdAt DateTime @default(now())
  expiresAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Participant {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  phone             String?
  tags              String[]
  location          String?
  organization      String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  activityLogs      ActivityLog[]
  assessmentHistory Assessment[] @relation("ParticipantScores")
}

model ActivityLog {
  id            String      @id @default(cuid())
  participantId String
  activity      String
  details       String?
  createdAt     DateTime    @default(now())
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model Assessment {
  id                String        @id @default(cuid())
  title             String
  description       String?
  type              String        // mcq, coding, proctored, hybrid
  status            String        @default("draft") // draft, live, archived
  duration          Int           // in minutes
  totalMarks        Int
  totalQuestions    Int
  attemptLimit      Int           @default(1)
  showResults       Boolean       @default(true)
  enableProctoring  Boolean       @default(false)
  randomizeQuestions Boolean      @default(false)
  tags              String[]
  notes             String?       // Moved from the first Assessment model
  participantScores Participant[] @relation("ParticipantScores") // Relation to track participant scores
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id])
  questions         Question[]
  candidates        Candidate[]
  analytics         AssessmentAnalytics?
}

model Question {
  id            String      @id @default(cuid())
  assessmentId  String
  question      String
  type          String      // multiple_choice, coding, text
  options       Json?       // For multiple choice
  correctAnswer Json?       // Could be string for MCQ or test cases for coding
  marks         Int
  order         Int
  hints         String[]
  explanation   String?
  difficulty    String?     // easy, medium, hard
  tags          String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  @@index([assessmentId])
}

model Candidate {
  id            String        @id @default(cuid())
  assessmentId  String
  userId        String?
  name          String
  email         String
  status        String        @default("invited") // invited, started, submitted, evaluated
  score         Int?         
  timeSpent     Int?         // in seconds
  startedAt     DateTime?
  submittedAt   DateTime?
  answers       Json?        // Store candidate's answers
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([assessmentId])
  @@index([userId])
}

model AssessmentAnalytics {
  id                   String     @id @default(cuid())
  assessmentId         String     @unique
  totalCandidates      Int        @default(0)
  completedCandidates  Int        @default(0)
  averageScore         Float?     @default(0)
  completionRate       Float?     @default(0)
  scoreDistribution   Json?      // Store score distribution data
  questionStatistics   Json?      // Stats per question
  updatedAt            DateTime   @updatedAt
  assessment           Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}
